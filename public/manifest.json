{
  "manifest_version": 3,
  "name": "DevTab - Developer New Tab",
  "version": "1.0.0",
  "description": "High-performance developer dashboard replacing your New Tab page with GitHub feeds, Hacker News, Ctrl+K search, scratchpad, and focus tools.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "bookmarks"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://api.coingecko.com/*"
  ],
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
